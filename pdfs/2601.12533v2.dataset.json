468283}, "shared": {"value": false, "score": 0.00013284296437632293}}}, {"rawForm": "DroneFace dataset", "type": "dataset-name", "dataset-name": {"rawForm": "DroneFace dataset", "normalizedForm": "DroneFace dataset", "offsetStart": 4, "offsetEnd": 21, "boundingBoxes": [{"p": 4, "x": 152.244, "y": 147.022, "w": 53.9825, "h": 10.4847}, {"p": 4, "x": 225.924, "y": 147.022, "w": 37.1352, "h": 10.4847}]}, "normalizedForm": "DroneFace dataset", "context": "The DroneFace dataset contains a total of 2,057 images including 620 raw images, 1,364 frontal face images, and 73 portrait images.", "mentionContextAttributes": {"used": {"value": false, "score": 0.2722637951374054}, "created": {"value": false, "score": 0.1689930558204651}, "shared": {"value": true, "score": 0.5587431192398071}}, "documentContextAttributes": {"used": {"value": true, "score": 0.992479681968689}, "created": {"value": false, "score": 0.1689930558204651}, "shared": {"value": true, "score": 0.5587431192398071}}, "references": [{"label": "[1]", "normalizedForm": "[1]", "refKey": 0}]}, {"rawForm": "images", "type": "dataset-implicit", "dataset-implicit": {"rawForm": "images", "normalizedForm": "images", "offsetStart": 4, "offsetEnd": 10, "bestDataType": "image", "bestTypeScore": 0.9983, "hasDataset": 0.9999933838844299, "boundingBoxes": [{"p": 4, "x": 464.863, "y": 190.36, "w": 34.5338, "h": 10.4847}]}, "normalizedForm": "images", "context": "The images were captured in a controlled setting, utilizing a total of 11 subjects and stationary poses and neutral expressions.", "mentionContextAttributes": {"used": {"value": true, "score": 0.9998068809509277}, "created": {"value": false, "score": 0.00014073836791794747}, "shared": {"value": false, "score": 5.24633469467517e-05}}}, {"rawForm": "raw", "type": "dataset-implicit", "dataset-implicit": {"rawForm": "raw", "normalizedForm": "raw", "offsetStart": 6, "offsetEnd": 9, "bestDataType": "image", "bestTypeScore": 0.9993, "hasDataset": 0.9999999403953552, "boundingBo