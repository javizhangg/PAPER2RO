eated": {"value": true, "score": 0.8129914999008179}, "shared": {"value": false, "score": 0.02993130497634411}}, "documentContextAttributes": {"used": {"value": true, "score": 0.9993394017219543}, "created": {"value": true, "score": 0.9987812042236328}, "shared": {"value": false, "score": 0.10022392868995667}}}, {"rawForm": "Keyhole imagery", "type": "dataset-name", "dataset-name": {"rawForm": "Keyhole imagery", "normalizedForm": "Keyhole imagery", "offsetStart": 81, "offsetEnd": 96, "boundingBoxes": [{"p": 2, "x": 197.237, "y": 363.43, "w": 77.17850000000001, "h": 9.980799999999988}]}, "normalizedForm": "Keyhole imagery", "context": "Here we introduce a global grid-based dataset that  organizes declassified U.S. Keyhole imagery (1960-1984) for direct reuse, built on a global equal-area  sinusoidal grid.", "mentionContextAttributes": {"used": {"value": false, "score": 0.0008719719480723143}, "created": {"value": true, "score": 0.9987812042236328}, "shared": {"value": false, "score": 0.0003467274073045701}}, "documentContextAttributes": {"used": {"value": true, "score": 0.9993394017219543}, "created": {"value": true, "score": 0.9987812042236328}, "shared": {"value": false, "score": 0.10022392868995667}}}, {"rawForm": "Keyhole \\n\\narchive", "type": "dataset-name", "dataset-name": {"rawForm": "Keyhole \n\narchive", "normalizedForm": "Keyhole archive", "offsetStart": 134, "offsetEnd": 151, "boundingBoxes": [{"p": 3, "x": 502.741, "y": 213.67, "w": 37.2442, "h": 9.9808}, {"p": 3, "x": 72.0, "y": 237.07, "w": 32.3471, "h": 9.9808}]}, "normalizedForm": "Keyhole archive", "context": "Given that the earliest civil satellite  programs as Landsat MSS only began in 1972 with coarse spatial resolutions of 30-60 m , the Keyhole  archive remains the sole global dataset providing high-resolution imagery of the Earth's surface from the  1960s to the 1980s.", "mentionContextAttributes": {"used": {"value": false, "score": 0.2720755338668823}, "created": {"value": true, "score": 0.6271225810050964}, "shared": {"value": false, "score": 0.10080188512802124}}, "documentContextAttributes": {"used": {"value": true, "score": 0.5339974164962769}, "created": {"value": true, "score": 0.6271225810050964}, "shared": {"value": false, "score": 0.10080188512802124}}}, {"rawForm": "Keyhole \\n\\nimagery", "type": "dataset-name", "dataset-name": {"rawForm": "Keyhole \n\nimagery", "normalizedForm": "Keyhole imagery", "offsetStart": 70, "offsetEnd": 87, "boundingBoxes": [{"p": 3, "x": 502.416, "y": 385.45, "w": 37.2991, "h": 9.9808}, {"p": 3, "x": 72.0, "y": 408.85, "w": 35.9485, "h": 9.9808}]}, "normalizedForm": "Keyhole imagery", "context": "Archaeology is one of the most prominent domains of application since Keyhole  imagery has been employed to map ancient irrigation systems , fortifications , and settlement patterns across the Middle East and North Africa.", "mentionContextAttributes": {"used": {"value": false, "score": 0.4344027042388916}, "created": {"value": false, "score": 0.4955238699913025}, "shared": {"value": false, "score": 0.07007336616516113}}, "documentContextAttributes": {"used": {"value": true, "score": 0.9993394017219543}, "created": {"value": true, "score": 0.9987812042236328}, "shared": {"value": false, "score": 0.10022392868995667}}}, {"rawForm": "Keyhole imagery", "type": "dataset-name", "dataset-name": {"rawForm": "Keyhole imagery", "normalizedForm": "Keyhole imagery", "offsetStart": 95, "offsetEnd": 110, "boundingBoxes": [{"p": 3, "x": 119.741, "y": 572.67, "w": 75.49649999999998, "h": 9.980800000000045}]}, "normalizedForm": "Keyhole imagery", "context": "Recent advances show that standardized preprocessing and classification workflows  can render Keyhole imagery a reliable and reproducible resource for long-term land use mapping, achieving  high accuracies when combined with ancillary terrain information .", "mentionContextAttributes": {"used": {"value": false, "score": 0.023195747286081314}, "created": {"value": true, "score": 0.9242322444915771}, "shared": {"value": false, "score": 0.05257197096943855}}, "documentContextAttributes": {"used": {"value": true, "score": 0.9993394017219543}, "created": {"value": true, "score": 0.9987812042236328}, "shared": {"value": false, "score": 0.10022392868995667}}}, {"rawForm": "Keyhole imagery", "type": "dataset-name", "dataset-name": {"rawForm": "Keyhole imagery", "normalizedForm": "Keyhole imagery", "offsetStart": 60, "offsetEnd": 75, "boundingBoxes": [{"p": 3, "x": 182.689, "y": 619.47, "w": 76.7175, "h": 9.980800000000045}]}, "normalizedForm": "Keyhole imagery", "context": "These diverse applications have  transitioned declassified Keyhole imagery from a military reconnaissance dataset to a versatile scientific  resource, bridging the observational gap in Earth system research during the mid-20th century and  providing a unique temporal reference for understanding environmental and cultural change.", "mentionContextAttributes": {"used": {"value": false, "score": 0.003976860083639622}, "created": {"value": true, "score": 0.9939492344856262}, "shared": {"value": false, "score": 0.002073899609968066}}, "documentContextAttributes": {"used": {"value": true, "score": 0.9993394017219543}, "created": {"value": true, "score": 0.9987812042236328}, "shared": {"value": false, "score": 0.10022392868995667}}}, {"rawForm": "Keyhole imagery", "type": "dataset-name", "dataset-name": {"rawForm": "Keyhole imagery", "normalizedForm": "Keyhole imagery", "offsetStart": 67, "offsetEnd": 82, "boundingBoxes": [{"p": 3, "x": 382.464, "y": 697.71, "w": 76.67350000000005, "h": 9.980800000000045}]}, "normalizedForm": "Keyhole imagery", "context": "Despite its significance, the spatial and temporal distribution of Keyhole imagery is highly uneven.", "mentionContextAttributes": {"used": {"value": true, "score": 0.6127361059188843}, "created": {"value": false, "score": 0.2870398759841919}, "shared": {"value": false, "score": 0.10022392868995667}}, "documentContextAttributes": {"used": {"value": true, "score": 0.9993394017219543}, "created": {"value": true, "score": 0.9987812042236328}, "shared": {"value": false, "score": 0.10022392868995667}}}, {"rawForm": "Keyhole archive", "type": "dataset-name", "dataset-name": {"rawForm": "Keyhole archive", "normalizedForm": "Keyhole archive", "offsetStart": 85, "offsetEnd": 100, "boundingBoxes": [{"p": 4, "x": 362.5, "y": 190.27, "w": 71.34258749999998, "h": 9.980799999999988}]}, "normalizedForm": "Keyhole archive", "context": "Besides, the free- download images only represent a subset of the full declassified Keyhole archive, so its spatial-temporal  distribution differs from that of the full dataset .", "mentionContextAttributes": {"used": {"value": true, "score": 0.5339974164962769}, "created": {"value": false, "score": 0.37981173396110535}, "shared": {"value": false, "score": 0.0861908569931984}}, "documentContextAttributes": {"used": {"value": true, "score": 0.5339974164962769}, "created": {"value": true, "score": 0.6271225810050964}, "shared": {"value": false, "score": 0.10080188512802124}}}, {"rawForm": "Keyhole imagery", "type": "dataset-name", "dataset-name": {"rawForm": "Keyhole imagery", "normalizedForm": "Keyhole imagery", "offsetStart": 64, "offsetEnd": 79, "boundingBoxes": [{"p": 4, "x": 388.441, "y": 338.65, "w": 75.33023750000001, "h": 9.980799999999988}]}, "normalizedForm": "Keyhole imagery", "context": "Although regional studies revealed the spatial heterogeneity of Keyhole imagery, comprehensive  global assessments remain lacking.", "mentionContextAttributes": {"used": {"value": true, "score": 0.9810938239097595}, "created": {"value": false, "score": 0.017191298305988312}, "shared": {"value": false, "score": 0.0017148215556517243}}, "documentContextAttributes": {"used": {"value": true, "score": 0.9993394017219543}, "created": {"value": true, "score": 0.9987812042236328}, "shared": {"value": false, "score": 0.10022392868995667}}}, {"rawForm": "PlanetScope \\n\\nconstellation", "type": "dat